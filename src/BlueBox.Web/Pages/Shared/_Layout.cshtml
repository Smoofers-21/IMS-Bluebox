@{
    var section = ViewData["Section"] as string;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · BlueBox</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="workspace-label">BLUEBOX <span>/</span> INVENTORY WORKSPACE</div>
    <div class="app-shell">
        <header class="app-header">
            <a class="brand" asp-page="/Overview"><span class="brand-mark" aria-hidden="true"><svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="m12 3 9 5v8l-9 5-9-5V8z"/><path d="m3 8 9 5 9-5M12 13v8M7.5 5.5l9 5"/></svg></span> BlueBox</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav aria-label="Main navigation">
                    <a asp-page="/Overview" aria-current="@(section == "Overview" ? "page" : null)">Overview</a>
                    <a asp-page="/Catalog/Index" aria-current="@(section == "Catalog" ? "page" : null)">Catalog</a>
                    <a asp-page="/Inventory/Index" aria-current="@(section == "Inventory" ? "page" : null)">Inventory</a>
                    <a asp-page="/Inventory/Move" aria-current="@(section == "Move" ? "page" : null)">Move stock</a>
                    <a asp-page="/Activity/Index" aria-current="@(section == "Activity" ? "page" : null)">Activity</a>
                    @if(User.IsInRole("MANAGER")) { <a asp-page="/Admin/Items" asp-route-id="" aria-current="@(section == "Admin" ? "page" : null)">Manage</a> }
                </nav>
                <div class="account">
                    <span><strong>@User.Identity.Name</strong><small>@(User.IsInRole("MANAGER") ? "Manager" : "Staff")</small></span>
                    <form method="post" asp-page="/Account/Logout"><button class="text-button" type="submit">Sign out</button></form>
                </div>
            }
            else
            {
                <span class="badge">STAFF ACCESS</span>
            }
        </header>
        <main id="main">@RenderBody()</main>
    </div>
    <footer class="site-footer"><span>BLUEBOX / WAREHOUSE INVENTORY</span><span>Internal employee workspace</span></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
