@page "{id:int?}"
@model BlueBox.Web.Pages.Admin.ItemsModel
@{ ViewData["Title"] = "Manage catalog"; ViewData["Section"] = "Admin"; }
<partial name="_Navigation" />
<div class="page-heading"><div><p class="eyebrow">MANAGER TOOLS</p><h1>Manage catalog</h1><p class="muted">Create separate entries for each format. Add stock through check-in.</p></div></div>
@if(TempData["Success"] is string message) { <div class="notice" role="status">@message</div> }
<div class="admin-grid">
<section class="panel"><h2>@(Model.Id.HasValue ? $"Edit item #{Model.Id}" : "New item")</h2>
<form method="post" id="item-form" asp-page="/Admin/Items" asp-all-route-data="Model.ItemRouteValues" asp-route-Search="@Model.Search" asp-route-PageNumber="@Model.PageNumber">

<div asp-validation-summary="All" class="validation" role="alert"></div>
<label asp-for="Input.Name">Title</label><input asp-for="Input.Name" maxlength="150" required />
<div class="form-row"><div><label asp-for="Input.Type">Type</label><select asp-for="Input.Type" disabled="@Model.HasHistory"><option value="MOVIE">Movie</option><option value="GAME">Game</option></select></div><div><label asp-for="Input.Format">Format / platform</label><input asp-for="Input.Format" readonly="@Model.HasHistory" maxlength="30" placeholder="DVD, Blu-ray, PS5…" required /></div></div>
@if(Model.HasHistory) { <input type="hidden" asp-for="Input.Type" id="item-type-value" /><p class="help">Type and format are fixed after the first stock movement. Create a new catalog entry for another edition.</p> }
<section class="lookup-box" id="movie-lookup" aria-label="Optional movie lookup">
<h3>Find a movie</h3><p class="help">Search OMDb, select the title and year, then review the metadata before saving.</p>
<label for="movie-title">Movie search</label><input id="movie-title" maxlength="150" placeholder="Movie title" />
<button type="button" class="button small" id="lookup-button">Search movies</button>
<p id="lookup-status" class="help" role="status"></p><div id="movie-matches"></div>
</section>
<label asp-for="Input.PosterUrl">Poster URL (optional)</label><input asp-for="Input.PosterUrl" type="url" maxlength="2048" placeholder="https://…" />
<label asp-for="Input.AgeRating">Age rating (optional)</label><input asp-for="Input.AgeRating" maxlength="20" placeholder="PG-13, E…" />
<label asp-for="Input.Status">Status</label><select asp-for="Input.Status"><option value="ACTIVE">Active</option><option value="ARCHIVED">Archived</option></select>
<p class="help">Archiving requires zero stock at every warehouse. History is retained.</p>
<div class="form-actions"><a class="button" id="new-item-link" href="@Url.Page("/Admin/Items", new { id = (int?)null })">New item</a><button type="submit" class="button primary">Save item</button></div>
</form></section>
<section><form method="get" action="@Url.Page("/Admin/Items", new { id = (int?)null })" class="filter-bar"><label class="search-field"><span class="sr-only">Find an item</span><input asp-for="Search" placeholder="Find by title or ID" maxlength="150" /></label><button class="button" type="submit">Find</button></form>
<div class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Item / format</th><th>Status</th><th>Stock</th><th>Action</th></tr></thead><tbody>
@foreach(var item in Model.Items) { <tr><td>@item.Name<small class="cell-subtitle">#@item.ItemId · @item.Format · @item.Type</small></td><td>@item.Status</td><td>@item.OnHand</td><td><a class="button small" asp-page="Items" asp-route-id="@item.ItemId" asp-route-Search="@Model.Search" asp-route-PageNumber="@Model.PageNumber">Edit</a></td></tr> }
</tbody></table></div><div class="table-caption activity-pager">
    <span>Page @Model.PageNumber · @Model.Items.Count catalog entries.</span>
    <nav aria-label="Manage catalog pages">
        @if (Model.PageNumber > 1)
        {
            <a class="button small" asp-page="/Admin/Items" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-Search="@Model.Search" asp-all-route-data="Model.ItemRouteValues" rel="prev">← Previous</a>
        }
        @if (Model.HasNextPage && Model.PageNumber < int.MaxValue)
        {
            <a class="button small" asp-page="/Admin/Items" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-Search="@Model.Search" asp-all-route-data="Model.ItemRouteValues" rel="next">Next →</a>
        }
    </nav>
</div></div></section>
</div>
@section Scripts { <script src="~/js/movies.js" asp-append-version="true" defer></script> }
