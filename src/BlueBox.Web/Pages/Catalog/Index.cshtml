@page
@model BlueBox.Web.Pages.Catalog.IndexModel
@{
    ViewData["Title"] = "Item catalog";
    ViewData["Section"] = "Catalog";
}
<div class="page-heading"><div><p class="eyebrow">CATALOG</p><h1>Item catalog</h1><p class="muted">Find movies and games across your warehouses.</p></div><span class="count-chip">@Model.Rows.Count shown</span></div>
<form method="get" class="filter-bar" role="search">
    <label class="search-field"><span class="sr-only">Search by item name or ID</span><input name="Search" value="@Model.Search" placeholder="Search by item name or ID" maxlength="150" /></label>
    <label><span class="sr-only">Item type</span><select asp-for="Type"><option value="">All item types</option><option value="MOVIE">Movies</option><option value="GAME">Games</option></select></label>
    <button class="button" type="submit">Search</button><a class="text-button" asp-page="Index">Reset</a>
</form>
<section class="panel table-panel" aria-label="Catalog items">
    <div class="table-scroll"><table><thead><tr><th>Title</th><th>Item ID</th><th>Type</th><th>Format</th><th>Age rating</th><th>On hand</th><th><span class="sr-only">Details</span></th></tr></thead><tbody>
    @foreach (var item in Model.Rows)
    {
        <tr><td><a class="item-name" asp-page="Details" asp-route-id="@item.ItemId"><span class="mini-cover @(item.Type == "GAME" ? "game" : "")" aria-hidden="true">@(item.Type == "GAME" ? "◇" : "◒")</span>@item.Name</a>@if(item.Status != "ACTIVE") { <span class="badge">Archived</span> }</td><td class="muted">#@item.ItemId</td><td><span class="badge @(item.Type == "GAME" ? "neutral" : "")">@(item.Type == "GAME" ? "Game" : "Movie")</span></td><td>@item.Format</td><td>@(item.Rating ?? "—")</td><td><strong>@item.OnHand</strong></td><td><a asp-page="Details" asp-route-id="@item.ItemId" aria-label="View @item.Name details">→</a></td></tr>
    }
    </tbody></table></div>
    @if (Model.Rows.Count == 0) { <div class="empty-state"><h2>No matching items</h2><p>Try another title or clear your filters.</p></div> }
    <div class="table-caption activity-pager">
    <span>Page @Model.PageNumber · @Model.Rows.Count catalog entries. Quantities include all warehouse locations.</span>
    <nav aria-label="Catalog pages">
        @if (Model.PageNumber > 1)
        {
            <a class="button small" asp-page="Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-Search="@Model.Search" asp-route-Type="@Model.Type" rel="prev">← Previous</a>
        }
        @if (Model.HasNextPage && Model.PageNumber < int.MaxValue)
        {
            <a class="button small" asp-page="Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-Search="@Model.Search" asp-route-Type="@Model.Type" rel="next">Next →</a>
        }
    </nav>
</div>
</section>
