@page
@model BlueBox.Web.Pages.Activity.IndexModel
@{
    ViewData["Title"] = "Activity log";
    ViewData["Section"] = "Activity";
}
<div class="page-heading"><div><p class="eyebrow">MOVEMENT HISTORY</p><h1>Activity log</h1><p class="muted">See what moved, where it moved, and who recorded it.</p></div></div>
<form method="get" class="filter-bar" role="search"><label class="search-field"><span class="sr-only">Search by item name or ID</span><input asp-for="Search" maxlength="150" placeholder="Search by item name or ID" /></label><label><span class="sr-only">Movement type</span><select asp-for="Direction"><option value="">All movements</option><option value="CHECK IN">Check in</option><option value="CHECK OUT">Check out</option></select></label><label><span class="sr-only">Warehouse</span><select asp-for="LocationId"><option value="">All locations</option>@foreach(var l in Model.Locations) { <option value="@l.LocationId">@l.LocationName</option> }</select></label><button type="submit" class="button">Filter</button><a class="text-button" asp-page="Index">Reset</a></form>
<section class="panel table-panel" aria-label="Stock movement history"><div class="table-scroll"><table><thead><tr><th>Log ID</th><th>Item</th><th>Movement</th><th>Warehouse</th><th>Qty</th><th>Employee</th><th>Recorded (UTC)</th><th>Notes</th></tr></thead><tbody>
@foreach(var row in Model.Rows) { <tr><td class="muted">#@row.Id</td><td><strong>@row.Name</strong><small class="cell-subtitle">@row.Format</small></td><td><span class="badge @(row.Direction == "CHECK IN" ? "neutral" : "")">@(row.Direction == "CHECK IN" ? "Check in" : "Check out")</span></td><td>@row.Location</td><td class="movement-quantity">@(row.Direction == "CHECK IN" ? "+" : "−")@row.Quantity</td><td>@row.Employee</td><td class="nowrap"><time datetime="@DateTime.SpecifyKind(row.Time, DateTimeKind.Utc).ToString("O")">@row.Time.ToString("MMM d, yyyy · HH:mm", System.Globalization.CultureInfo.InvariantCulture)</time></td><td class="notes">@(row.Notes ?? "—")</td></tr> }
</tbody></table></div>@if(Model.Rows.Count == 0) { <div class="empty-state"><h2>No movements found</h2><p>Record a stock movement, return to an earlier page, or try another filter.</p></div> }
<div class="table-caption activity-pager">
    <span>Page @Model.PageNumber · @Model.Rows.Count movements · Times shown in UTC</span>
    <nav aria-label="Activity pages">
        @if (Model.PageNumber > 1)
        {
            <a class="button small" asp-page="Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-Search="@Model.Search" asp-route-Direction="@Model.Direction" asp-route-LocationId="@Model.LocationId" rel="prev">← Newer</a>
        }
        @if (Model.HasNextPage)
        {
            <a class="button small" asp-page="Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-Search="@Model.Search" asp-route-Direction="@Model.Direction" asp-route-LocationId="@Model.LocationId" rel="next">Older →</a>
        }
    </nav>
</div></section>
