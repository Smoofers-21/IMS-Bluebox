@page
@model BlueBox.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Staff sign-in";
}
@if(TempData["Notice"] is string notice) { <div class="notice" role="status">@notice</div> }
<div class="login-grid">
    <section class="login-story">
        <p class="eyebrow">BLUEBOX INVENTORY</p>
        <h1>Everything<br /> in its place.</h1>
        <p>Movies, games, and the stock that keeps<br class="desktop-break" /> your warehouses moving.</p>
        <div class="box-art" aria-hidden="true"><div class="box box-back"></div><div class="box box-front"><span>◇</span><i></i><i></i></div><div class="orbit"></div></div>
        <div class="story-footer">CATALOG <span>/</span> INVENTORY <span>/</span> ACTIVITY</div>
    </section>
    <section class="login-form panel">
        <div class="lock-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 14v3"/></svg></div>
        <p class="eyebrow">EMPLOYEE ACCESS</p>
        <h2>Sign in to BlueBox</h2>
        <p class="muted">Use your employee account to continue.</p>
        @if (Model.PublicDemoEnabled)
        {
            <details class="demo-access" id="demo-access">
                <summary>Try the demo</summary>
                <div class="demo-access-content">
                    <p class="help">Shared demo with fictional data. Staff access allows inventory changes; manager tools are restricted. Changes are saved and visible to other visitors.</p>
                    <p class="help">Copy these credentials into the sign-in form below, then choose Sign in. You can also select the text to copy it manually.</p>
                    <label for="demo-username">Demo username</label>
                    <div class="demo-credential-row">
                        <input id="demo-username" type="text" value="@Model.PublicDemoUsername" readonly autocomplete="off" autocapitalize="none" spellcheck="false" />
                        <button type="button" class="button small" data-demo-copy="demo-username" data-demo-label="Username" aria-label="Copy demo username" hidden>Copy</button>
                    </div>
                    <label for="demo-password">Demo password</label>
                    <div class="demo-credential-row">
                        <input id="demo-password" type="text" value="@Model.PublicDemoPassword" readonly autocomplete="off" autocapitalize="none" spellcheck="false" />
                        <button type="button" class="button small" data-demo-copy="demo-password" data-demo-label="Password" aria-label="Copy demo password" hidden>Copy</button>
                    </div>
                    <p class="help demo-copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
                </div>
            </details>
        }
        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
            <label asp-for="Username">Username</label>
            <input asp-for="Username" autocomplete="username" autofocus maxlength="50" required />
            <span asp-validation-for="Username" class="validation"></span>
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" autocomplete="current-password" required maxlength="@BlueBox.Web.Models.PasswordPolicy.MaximumLength" />
            <span asp-validation-for="Password" class="validation"></span>
            <button type="submit" class="button primary full">Sign in <span aria-hidden="true">→</span></button>
        </form>
        <p class="help">Accounts are provided by your warehouse manager.</p>
    </section>
</div>
@section Scripts {
    @if (Model.PublicDemoEnabled)
    {
        <script src="~/js/demo-login.js" asp-append-version="true" defer></script>
    }
}
